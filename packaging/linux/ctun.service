# User-level systemd unit: keeps the ctun gateway tunnel up across
# reboots and restarts the daemon (and with it the ngrok agent) if the
# process ever dies. The ctun CLI detects unit ownership via the
# daemon's cgroup and routes `ctun shutdown`, `ctun restart` and
# `ctun up` through systemctl automatically, so both manage the same
# daemon. Install with:
#   cp packaging/linux/ctun.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ctun
# To start at boot without an active login session, also run:
#   sudo loginctl enable-linger $USER

[Unit]
Description=ctun MCP gateway daemon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/ctun --internal-daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
